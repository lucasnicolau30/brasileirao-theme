  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave e armazenamento",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9a9a9a"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#e6c79c"
      }
    },
    {
      "name": "Escapes e interpolação",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f0b890"
      }
    },
    {
      "name": "Números e constantes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e0a070"
      }
    },
    {
      "name": "Funções e métodos",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#a8c7e6"
      }
    },
    {
      "name": "Tipos e classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#c9d6a8"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e6e6e6"
      }
    },
    {
      "name": "this e self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#cfcfcf"
      }
    },
    {
      "name": "Tags e seletores",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.css",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#a8c7e6"
      }
    },
    {
      "name": "Pontuação",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "Colchetes",
      "scope": [
        "meta.brace",
        "punctuation.parenthesis",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "punctuation.definition.dict",
        "punctuation.definition.list",
        "punctuation.definition.set",
        "punctuation.definition.binding-pattern",
        "punctuation.section.block",
        "punctuation.section.parens",
        "punctuation.section.brackets",
        "punctuation.section.braces",
        "punctuation.section.property-list",
        "punctuation.section.function",
        "punctuation.section.arguments",
        "punctuation.section.group",
        "punctuation.section.array",
        "punctuation.section.scope"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Decoradores e anotações",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#f0b890"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#a8c7e6"
      }
    },
    {
      "name": "Markdown: código inline",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#e6c79c"
      }
    },
    {
      "name": "Diff: adicionado",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#5fb760"
      }
    },
    {
      "name": "Diff: removido",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e8452c"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#b3261e"
      }
    }
  ]
}
